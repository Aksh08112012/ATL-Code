// ---------------- RGB LED ----------------
void setPriorityColor(String priority){

  digitalWrite(RED,LOW);
  digitalWrite(GREEN,LOW);
  digitalWrite(BLUE,LOW);

  if(priority=="green"){

    digitalWrite(GREEN,HIGH);

  }

  else if(priority=="yellow"){

    digitalWrite(RED,HIGH);
    digitalWrite(GREEN,HIGH);

  }

  else if(priority=="red"){

    digitalWrite(RED,HIGH);

  }

}

// ---------------- Buzzer ----------------
void buzzGeneral(){

  digitalWrite(BUZZER,HIGH);
  delay(200);
  digitalWrite(BUZZER,LOW);

}

void buzzImportant(){

  for(int i=0;i<2;i++){

    digitalWrite(BUZZER,HIGH);
    delay(150);

    digitalWrite(BUZZER,LOW);
    delay(120);

  }

}

void buzzEmergency(){

  for(int i=0;i<3;i++){

    digitalWrite(BUZZER,HIGH);
    delay(180);

    digitalWrite(BUZZER,LOW);
    delay(100);

  }

}

// ---------------- Receive Notice ----------------
void sendNotice(){

  currentMessage = server.arg("msg");
  currentPriority = server.arg("p");

  currentMessage.trim();

  if(currentMessage==""){

    server.send(400,"text/plain","Empty Notice");
    return;

  }

  // Reset display engine
  pageIndex = 0;
  longWordIndex = 0;
  lastScroll = 0;
  messageStart = millis();

  noNoticeShown = false;

  // Priority indication
  setPriorityColor(currentPriority);

  if(currentPriority=="green"){

    buzzGeneral();

  }

  else if(currentPriority=="yellow"){

    buzzImportant();

  }

  else{

    buzzEmergency();

  }

  lcd.setCursor(0,0);
  lcd.print("                ");
  lcd.setCursor(0,1);
  lcd.print("                ");

  server.send(200,"text/plain","Notice Sent");

}

// ---------------- Build One LCD Line ----------------
String buildLine(String text, int &index){

  while(index < text.length() && text[index] == ' ')
    index++;

  String line = "";

  while(index < text.length()){

    int nextSpace = text.indexOf(' ', index);

    if(nextSpace == -1)
      nextSpace = text.length();

    String word = text.substring(index, nextSpace);

    // Very long word
    if(word.length() > 16){

      if(line == "")
        return "#LONGWORD#" + word;

      break;
    }

    if(line == ""){

      line = word;

    }

    else if(line.length() + 1 + word.length() <= 16){

      line += " ";
      line += word;

    }

    else{

      break;

    }

    index = nextSpace + 1;

  }

  return line;

}

// ---------------- Scroll Very Long Word ----------------
void showLongWord(String word){

  String text = "                ";
  text += word;
  text += "                ";

  lcd.setCursor(0,0);
  lcd.print("                ");
  lcd.setCursor(0,1);
  lcd.print("                ");

  lcd.setCursor(0,0);
  lcd.print(text.substring(longWordIndex,
                           longWordIndex+16));

  lcd.setCursor(0,1);

  if(longWordIndex+16 < text.length()){

    lcd.print(text.substring(longWordIndex+16,
             min(longWordIndex+32,
             (int)text.length())));

  }

  longWordIndex++;

  if(longWordIndex > text.length()-16)
    longWordIndex = 0;

}

// ---------------- LCD Display Engine ----------------
void updateDisplay(){

  static String lastMessage = "";

  // No notice
  if(currentMessage==""){

    if(!noNoticeShown){

      lcd.setCursor(0,0);
      lcd.print("                ");
      lcd.setCursor(0,1);
      lcd.print("                ");

      lcd.setCursor(0,0);
      lcd.print("No Notice");
      lcd.setCursor(0,1);
      lcd.print("Waiting...");

      noNoticeShown=true;

    }

    lastMessage="";
    return;

  }

  // Notice expired
  if(millis()-messageStart>=60000){

    currentMessage="";
    currentPriority="";

    digitalWrite(RED,LOW);
    digitalWrite(GREEN,LOW);
    digitalWrite(BLUE,LOW);

    noNoticeShown=false;

    return;

  }

  noNoticeShown=false;

  // Fixed display if <=32 characters
  if(currentMessage.length()<=32){

    if(lastMessage!=currentMessage){

      int index=0;

      String line1=buildLine(currentMessage,index);
      String line2=buildLine(currentMessage,index);

      lcd.setCursor(0,0);
      lcd.print("                ");
      lcd.setCursor(0,1);
      lcd.print("                ");

      lcd.setCursor(0,0);
      lcd.print(line1);

      lcd.setCursor(0,1);
      lcd.print(line2);

      lastMessage=currentMessage;

    }

    return;

  }

  // Scroll speed
  if(millis()-lastScroll<500)
    return;

  lastScroll=millis();

  int index=pageIndex;

  String line1=buildLine(currentMessage,index);

  // Very long word
  if(line1.startsWith("#LONGWORD#")){

    showLongWord(line1.substring(10));
    return;

  }

  String line2=buildLine(currentMessage,index);

  if(line2.startsWith("#LONGWORD#")){

    showLongWord(line2.substring(10));
    return;

  }

  lcd.setCursor(0,0);
  lcd.print("                ");
  lcd.setCursor(0,0);
  lcd.print(line1);

  lcd.setCursor(0,1);
  lcd.print("                ");
  lcd.setCursor(0,1);
  lcd.print(line2);

  pageIndex=index;

  while(pageIndex<currentMessage.length() &&
        currentMessage[pageIndex]==' ')
    pageIndex++;

  if(pageIndex>=currentMessage.length())
    pageIndex=0;

}

// ---------------- Setup ----------------
void setup(){

  Serial.begin(115200);

  pinMode(RED,OUTPUT);
  pinMode(GREEN,OUTPUT);
  pinMode(BLUE,OUTPUT);
  pinMode(BUZZER,OUTPUT);

  digitalWrite(RED,LOW);
  digitalWrite(GREEN,LOW);
  digitalWrite(BLUE,LOW);
  digitalWrite(BUZZER,LOW);

  lcd.begin();
  lcd.backlight();

  // Welcome Screen
  lcd.setCursor(0,0);
  lcd.print("Smart Notice");

  lcd.setCursor(0,1);
  lcd.print("Board");

  delay(2000);

  // Starting
  lcd.setCursor(0,0);
  lcd.print("                ");
  lcd.setCursor(0,1);
  lcd.print("                ");

  lcd.setCursor(0,0);
  lcd.print("Starting...");
  delay(1000);

  // Create Wi-Fi AP
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid,password);

  // Show Wi-Fi Details
  lcd.setCursor(0,0);
  lcd.print("                ");
  lcd.setCursor(0,1);
  lcd.print("                ");

  lcd.setCursor(0,0);
  lcd.print(ssid);

  lcd.setCursor(0,1);
  lcd.print(WiFi.softAPIP());

  // Web Server
  server.on("/",handleRoot);
  server.on("/send",sendNotice);

  server.begin();

  // Serial Monitor
  Serial.println();
  Serial.println("==================================");
  Serial.println(" Smart Notice Board");
  Serial.println("==================================");
  Serial.print("SSID : ");
  Serial.println(ssid);
  Serial.print("PASS : ");
  Serial.println(password);
  Serial.print("IP   : ");
  Serial.println(WiFi.softAPIP());
  Serial.println("==================================");

  delay(3000);

  // Ready Screen
  lcd.setCursor(0,0);
  lcd.print("                ");
  lcd.setCursor(0,1);
  lcd.print("                ");

  lcd.setCursor(0,0);
  lcd.print("No Notice");

  lcd.setCursor(0,1);
  lcd.print("Waiting...");

  noNoticeShown = true;

}

// ---------------- Main Loop ----------------
void loop(){

  server.handleClient();

  updateDisplay();

}
