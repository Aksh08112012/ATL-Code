// ---------------- Receive Notice ----------------
void sendNotice(){

currentMessage = server.arg("msg");
currentPriority = server.arg("p");

// Remove leading/trailing spaces
currentMessage.trim();

// Remove repeated spaces
while(currentMessage.indexOf("  ") != -1){

currentMessage.replace("  "," ");

}

if(currentMessage==""){

server.send(400,"text/plain","Empty Notice");
return;

}

// Reset display engine
messageStart = millis();
lastScroll = 0;

pageIndex = 0;
scrollPage = 0;
longWordIndex = 0;

wordCount = 0;
lastMessage = "";
showingLongWord = false;
noNoticeShown = false;

// Split message into words
int start = 0;

while(start < currentMessage.length()){

int space = currentMessage.indexOf(' ', start);

if(space == -1)
space = currentMessage.length();

words[wordCount++] =
currentMessage.substring(start, space);

start = space + 1;

}

// Priority indication
setPriorityColor(currentPriority);

if(currentPriority=="green"){

buzzGeneral();

}
else if(currentPriority=="yellow"){

buzzImportant();

}
else{

buzzEmergency();

}

// Clear LCD
lcd.clear();

server.send(200,"text/plain","Notice Sent");

}

// ---------------- RGB LED ----------------
void setPriorityColor(String priority){

  digitalWrite(RED,LOW);
  digitalWrite(GREEN,LOW);
  digitalWrite(BLUE,LOW);

  if(priority=="green"){

    digitalWrite(GREEN,HIGH);

  }

  else if(priority=="yellow"){

    // Yellow = Red + Green
    // (Brightness balancing can be added later if needed)
    digitalWrite(RED,HIGH);
    digitalWrite(GREEN,HIGH);

  }

  else if(priority=="red"){

    digitalWrite(RED,HIGH);

  }

}

// ---------------- Buzzer ----------------
void buzzGeneral(){

  digitalWrite(BUZZER,HIGH);
  delay(200);
  digitalWrite(BUZZER,LOW);

}

void buzzImportant(){

  for(int i=0;i<2;i++){

    digitalWrite(BUZZER,HIGH);
    delay(150);

    digitalWrite(BUZZER,LOW);
    delay(120);

  }

}

void buzzEmergency(){

  for(int i=0;i<3;i++){

    digitalWrite(BUZZER,HIGH);
    delay(180);

    digitalWrite(BUZZER,LOW);
    delay(100);

  }

}

// ---------------- Build One LCD Line ----------------
String buildLine(int startWord, int &nextWord){

  String line = "";
  nextWord = startWord;

  while(nextWord < wordCount){

    String word = words[nextWord];

    // Long word handled separately
    if(word.length() > 16){

      if(line == "")
        return "#LONGWORD#" + word;

      break;

    }

    if(line == ""){

      line = word;

    }

    else if(line.length() + 1 + word.length() <= 16){

      line += " ";
      line += word;

    }

    else{

      break;

    }

    nextWord++;

  }

  return line;

}

// ---------------- Scroll Very Long Word ----------------
void showLongWord(String word){

  showingLongWord = true;

  String text = "                ";
  text += word;
  text += "                ";

  lcd.clear();

  lcd.setCursor(0,0);
  lcd.print(text.substring(longWordIndex,
                           longWordIndex+16));

  lcd.setCursor(0,1);

  if(longWordIndex+16 < text.length()){

    lcd.print(
      text.substring(
        longWordIndex+16,
        min(longWordIndex+32,
        (int)text.length())
      )
    );

  }

  longWordIndex++;

  if(longWordIndex >= text.length()-16){

    longWordIndex = 0;
    showingLongWord = false;

    // Move to next page after long word finishes
    scrollPage++;

    if(scrollPage >= wordCount)
      scrollPage = 0;

  }

}

// ---------------- LCD Display Engine ----------------
void updateDisplay(){

  // No notice
  if(currentMessage==""){

    if(!noNoticeShown){

      lcd.clear();

      lcd.setCursor(0,0);
      lcd.print("No Notice");

      lcd.setCursor(0,1);
      lcd.print("Waiting...");

      noNoticeShown=true;

    }

    return;

  }

  // Notice expires after 60 seconds
  if(millis()-messageStart>=60000){

    currentMessage="";
    currentPriority="";

    digitalWrite(RED,LOW);
    digitalWrite(GREEN,LOW);
    digitalWrite(BLUE,LOW);

    noNoticeShown=false;

    return;

  }

  noNoticeShown=false;

  // ---------- SHORT MESSAGE (<=32 chars) ----------
  if(currentMessage.length()<=32){

    if(lastMessage!=currentMessage){

      int nextWord=0;

      String line1=buildLine(0,nextWord);
      String line2=buildLine(nextWord,nextWord);

      if(line1.startsWith("#LONGWORD#")){

        showLongWord(line1.substring(10));
        return;

      }

      if(line2.startsWith("#LONGWORD#")){

        showLongWord(line2.substring(10));
        return;

      }

      lcd.clear();

      lcd.setCursor(0,0);
      lcd.print(line1);

      lcd.setCursor(0,1);
      lcd.print(line2);

      lastMessage=currentMessage;

    }

    return;

  }

  // ---------- LONG MESSAGE (>32 chars) ----------

  if(showingLongWord)
    return;

  if(millis()-lastScroll<1000)
    return;

  lastScroll=millis();

  int nextWord;

  String line1=buildLine(scrollPage,nextWord);

  if(line1.startsWith("#LONGWORD#")){

    showLongWord(line1.substring(10));
    return;

  }

  String line2=buildLine(nextWord,nextWord);

  if(line2.startsWith("#LONGWORD#")){

    showLongWord(line2.substring(10));
    return;

  }

  lcd.clear();

  lcd.setCursor(0,0);
  lcd.print(line1);

  lcd.setCursor(0,1);
  lcd.print(line2);

  // Move to next page (one word forward)
  scrollPage++;

  if(scrollPage>=wordCount)
    scrollPage=0;

}

// ---------------- Setup ----------------
void setup(){

  Serial.begin(9600);

  // ---------------- Pins ----------------
  pinMode(RED,OUTPUT);
  pinMode(GREEN,OUTPUT);
  pinMode(BLUE,OUTPUT);
  pinMode(BUZZER,OUTPUT);

  digitalWrite(RED,LOW);
  digitalWrite(GREEN,LOW);
  digitalWrite(BLUE,LOW);
  digitalWrite(BUZZER,LOW);

  // ---------------- LCD ----------------
  lcd.begin();
  lcd.backlight();

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("Smart Notice");

  lcd.setCursor(0,1);
  lcd.print("Board");

  delay(2000);

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("Starting...");

  delay(1000);

  // ---------------- WiFi AP ----------------
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid,password);

  lcd.clear();

  lcd.setCursor(0,0);
  lcd.print(ssid);

  lcd.setCursor(0,1);
  lcd.print(WiFi.softAPIP().toString());

  // ---------------- Web Server ----------------
  server.on("/",handleRoot);
  server.on("/send",sendNotice);

  server.begin();

  // ---------------- Initialize Variables ----------------
  currentMessage = "";
  currentPriority = "";

  messageStart = 0;
  lastScroll = 0;

  pageIndex = 0;
  scrollPage = 0;
  longWordIndex = 0;

  wordCount = 0;

  lastMessage = "";

  showingLongWord = false;
  noNoticeShown = true;

  // Clear word array
  for(int i=0;i<50;i++){

    words[i]="";

  }

  // ---------------- Serial Monitor ----------------
  Serial.println();
  Serial.println("==================================");
  Serial.println(" Smart Notice Board");
  Serial.println("==================================");
  Serial.print("SSID : ");
  Serial.println(ssid);

  Serial.print("PASS : ");
  Serial.println(password);

  Serial.print("IP   : ");
  Serial.println(WiFi.softAPIP());

  Serial.println("==================================");

  delay(3000);

  // ---------------- Ready Screen ----------------
  lcd.clear();

  lcd.setCursor(0,0);
  lcd.print("No Notice");

  lcd.setCursor(0,1);
  lcd.print("Waiting...");

}

// ---------------- Main Loop ----------------
void loop(){

  // Handle website requests
  server.handleClient();

  // Update LCD display
  updateDisplay();

}
