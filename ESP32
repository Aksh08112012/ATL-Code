#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

const char* ssid = "NoticeBoard";
const char* password = "12345678";

ESP8266WebServer server(80);
LiquidCrystal_I2C lcd(0x27,16,2);

// ---------------- Pins ----------------
#define RED D6
#define GREEN D7
#define BLUE D8
#define BUZZER D5

// ---------------- Notice Variables ----------------
String currentMessage = "";
String currentPriority = "";

unsigned long messageStart = 0;
unsigned long lastScroll = 0;

// ---------------- LCD Display Variables ----------------

// Old variables
int pageIndex = 0;
int longWordIndex = 0;

// New word-based scrolling
int scrollPage = 0;

// Stores all words of the current notice
String words[50];

// Number of words currently stored
int wordCount = 0;

// Prevents unnecessary LCD refresh
String lastMessage = "";

// LCD state
bool noNoticeShown = false;
bool showingLongWord = false;

